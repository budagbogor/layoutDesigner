# -----------------------------------------------------------------------------
# SumoPod AI Provider Configuration (Development)
#
# Copy this file to .env.local (which is git-ignored) and fill in your API key.
# Never commit actual API keys to git!
# -----------------------------------------------------------------------------

# SumoPod Bearer API Key (Required for real AI features)
SUMOPOD_API_KEY=your_sumopod_api_key_here

# SumoPod OpenAI-Compatible Base URL (Default: https://ai.sumopod.com/v1)
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# Default Model to use on SumoPod (Optional; if omitted, defaults to provider selection)
# Example models on SumoPod / OpenAI-compatible endpoints:
# SUMOPOD_MODEL=gpt-4o-mini
SUMOPOD_MODEL=
