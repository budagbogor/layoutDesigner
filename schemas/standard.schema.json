{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workshop Standard",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "status",
    "parameters",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "scoring": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scoreWeight"
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": [
        "key",
        "value",
        "unit",
        "constraint_level"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "constraint_level": {
          "type": "string",
          "enum": [
            "HARD",
            "SOFT",
            "OPTIMIZATION"
          ]
        },
        "source_type": {
          "type": "string"
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "name",
        "severity",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "HARD",
            "WARNING",
            "INFO"
          ]
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "scoreWeight": {
      "type": "object",
      "required": [
        "key",
        "weight"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}